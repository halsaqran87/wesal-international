# ─── SUPABASE ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── ANTHROPIC (AI Assistant) ──────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY

# ─── DAILY.CO (Video Calls) ───────────────────────────────
DAILY_API_KEY=YOUR_DAILY_KEY
NEXT_PUBLIC_DAILY_DOMAIN=wesal.daily.co

# ─── ZOHO MAIL (Email) ────────────────────────────────────
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_EMAIL=noreply@wesal-international.com
ZOHO_PASSWORD=YOUR_ZOHO_APP_PASSWORD

# ─── WHATSAPP (360dialog) ─────────────────────────────────
WHATSAPP_API_KEY=YOUR_360DIALOG_KEY
WHATSAPP_FROM_NUMBER=+96XXXXXXXXX

# ─── TAP PAYMENTS (Kuwait) ────────────────────────────────
TAP_SECRET_KEY=YOUR_TAP_SECRET
NEXT_PUBLIC_TAP_PUBLIC_KEY=YOUR_TAP_PUBLIC

# ─── APP ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://wesal-international.com
NEXT_PUBLIC_APP_NAME=Wesal International
